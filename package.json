{
  "name": "terrapreta",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "bun run typegen",
    "build": "next build",
    "check": "bunx ultracite check",
    "cleanup": "rm -rf node_modules .next",
    "predev": "bun run typegen",
    "dev": "next dev",
    "fix": "bunx ultracite fix",
    "setup:worktree": "node scripts/setup-worktree.mjs",
    "start": "next start",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "typegen": "bunx sanity schema extract --enforce-required-fields --path ./src/sanity/extract.json --force && bunx sanity typegen generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@calcom/embed-react": "^1.5.3",
    "@sanity/client": "^8.9.0",
    "@sanity/icons": "5.2.3",
    "@sanity/image-url": "^2.1.1",
    "@sanity/orderable-document-list": "^2.0.25",
    "@sanity/vision": "^6.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "16.3.7",
    "next-plausible": "^4.0.0",
    "next-sanity": "^13.3.4",
    "next-themes": "^0.4.6",
    "path-to-regexp": "6.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "^6.17.0",
    "sanity-plugin-media": "^6.3.2",
    "sonner": "^2.0.7",
    "styled-components": "^6.5.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "groq-js": "^2.0.0",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "ultracite": "7.12.2"
  },
  "packageManager": "bun@1.3.3",
  "engines": {
    "node": ">=22.12"
  }
}
