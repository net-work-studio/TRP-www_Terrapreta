    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "motion-plus": "https://api.motion.dev/registry?package=motion-plus&version=2.0.0-alpha.4&token=1ed6016587936dcc477527fbfad19c75d950ee338cbbae69c986127870766827",
